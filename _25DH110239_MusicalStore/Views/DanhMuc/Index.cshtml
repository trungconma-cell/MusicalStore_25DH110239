@model List<_25DH110239_MusicalStore.Data.Category>
@{
    ViewBag.Title = "Quản lý danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .card {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        margin-bottom: 20px;
    }

    .inline-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .inline-form input {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 13px;
            flex: 1;
        }

    .btn-black {
        background: #111;
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    th {
        background: #f8f8f8;
        font-weight: 600;
    }

    .btn-del {
        background: #fee;
        color: #c00;
        border: 1px solid #fcc;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
    }
</style>

<div class="card">
    <h2 style="margin-bottom:15px;">Thêm Thương Hiệu Mới</h2>
    @if (TempData["Error"] != null)
    {
        <div style="background:#fee; color:#c00; padding:10px; border-radius:4px; margin-bottom:12px; font-size:13px;">@TempData["Error"]</div>
    }
    <form method="post" action="@Url.Action("Them", "DanhMuc")" class="inline-form">
        <input type="text" name="categoryName" required placeholder="Tên thương hiệu (vd: Korg, Taylor...)" />
        <input type="text" name="description" placeholder="Mô tả ngắn về thương hiệu..." />
        <button type="submit" class="btn-black">+ Thêm danh mục</button>
    </form>
</div>

<div class="card">
    <h2 style="margin-bottom:15px;">Danh Sách Thương Hiệu Nhạc Cụ</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Tên thương hiệu</th>
                <th>Mô tả</th>
                <th>Số sản phẩm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>#@c.CategoryID</td>
                    <td><strong>@c.CategoryName</strong></td>
                    <td>@c.Description</td>
                    <td>@c.Products.Count sản phẩm</td>
                    <td>
                        <form method="post" action="@Url.Action("Xoa", "DanhMuc", new { id = c.CategoryID })" onsubmit="return confirm('Xóa danh mục này?');">
                            <button type="submit" class="btn-del">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>