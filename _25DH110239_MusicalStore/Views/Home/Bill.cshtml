@model _25DH110239_MusicalStore.Data.Order
@{
    ViewBag.Title = "Hóa đơn đặt hàng #" + Model.OrderID;
}

<style>
    .bill-box {
        max-width: 750px;
        margin: 30px auto;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 35px;
        background: #fff;
    }

    .bill-header {
        text-align: center;
        border-bottom: 2px solid #111;
        padding-bottom: 18px;
        margin-bottom: 20px;
    }

        .bill-header h1 {
            font-size: 24px;
            letter-spacing: 1px;
        }

    .bill-meta {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .bill-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

        .bill-table th, .bill-table td {
            border-bottom: 1px solid #eee;
            padding: 10px;
            text-align: left;
            font-size: 14px;
        }

        .bill-table th {
            background: #f8f8f8;
        }

    .bill-footer {
        text-align: right;
        font-size: 14px;
        line-height: 1.8;
    }

    .btn-group {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 25px;
    }

    .btn-black {
        background: #111;
        color: #fff;
        padding: 10px 22px;
        border-radius: 4px;
        font-size: 14px;
        border: none;
        cursor: pointer;
    }

    .btn-outline {
        border: 1px solid #111;
        color: #111;
        padding: 10px 22px;
        border-radius: 4px;
        font-size: 14px;
        background: #fff;
    }
</style>

<div class="bill-box">
    <div class="bill-header">
        <h1>MUSICAL STORE - HÓA ĐƠN ĐẶT HÀNG</h1>
        <p style="color:#666; font-size:13px; margin-top:4px;">Cảm ơn quý khách đã tin tưởng mua sắm nhạc cụ chính hãng!</p>
    </div>

    <div class="bill-meta">
        <div>
            <strong>Khách hàng:</strong> @Model.ReceiverName<br />
            <strong>Số điện thoại:</strong> @Model.ReceiverPhone<br />
            <strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery
        </div>
        <div style="text-align:right;">
            <strong>Mã đơn hàng:</strong> #@Model.OrderID<br />
            <strong>Ngày đặt:</strong> @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "")<br />
            <strong>Thanh toán:</strong> @Model.PaymentMethod (@Model.PaymentStatus)
        </div>
    </div>

    <table class="bill-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th style="text-align:right;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0")đ</td>
                    <td style="text-align:right;">@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="bill-footer">
        @if (Model.DiscountAmount > 0)
        {
            <div>Giảm giá voucher (@Model.VoucherCode): <strong>-@Model.DiscountAmount.Value.ToString("N0")đ</strong></div>
        }
        <div>Phí vận chuyển: <strong>@(Model.ShippingFee.HasValue ? Model.ShippingFee.Value.ToString("N0") : "0")đ</strong></div>
        <div style="font-size:18px; color:#d00; margin-top:6px;">
            TỔNG THANH TOÁN: <strong>@Model.TotalAmount.ToString("N0")đ</strong>
        </div>
    </div>

    <div class="btn-group">
        <button onclick="window.print()" class="btn-outline">In hóa đơn</button>
        <a href="@Url.Action("LichSuMuaHang", "Home")" class="btn-black">Xem đơn hàng của tôi</a>
    </div>
</div>