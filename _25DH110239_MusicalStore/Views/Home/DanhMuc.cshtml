@model List<_25DH110239_MusicalStore.Data.Product>
@using _25DH110239_MusicalStore.Data
@{
    var category = ViewBag.Category as Category;
    ViewBag.Title = category != null ? category.CategoryName : "Danh mục";
}

<style>
    .cat-banner {
        background: #111;
        color: #fff;
        padding: 40px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

        .cat-banner h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .cat-banner p {
            color: #ccc;
            font-size: 14px;
        }

    .filter-bar {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        background: #f8f8f8;
        padding: 15px;
        border-radius: 6px;
    }

        .filter-bar input, .filter-bar select {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 13px;
        }

    .btn-filter {
        background: #111;
        color: #fff;
        border: none;
        padding: 8px 18px;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        font-size: 13px;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .product-card {
        border: 1px solid #eaeaea;
        border-radius: 6px;
        padding: 14px;
        position: relative;
        background: #fff;
        display: flex;
        flex-direction: column;
        transition: 0.2s;
    }

        .product-card:hover {
            border-color: #111;
            transform: translateY(-2px);
        }

        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 12px;
        }

    .product-name {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .sale-price {
        color: #d00;
        font-weight: 700;
        font-size: 16px;
    }

    .old-price {
        color: #888;
        text-decoration: line-through;
        font-size: 13px;
        margin-left: 8px;
    }

    .badge-sale {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #d00;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 3px;
    }

    .pagination {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-top: 30px;
    }

    .page-link {
        padding: 8px 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 13px;
    }

        .page-link.active {
            background: #111;
            color: #fff;
            border-color: #111;
        }
</style>

<!-- Banner tên thương hiệu -->
<div class="cat-banner">
    <h1>THƯƠNG HIỆU @category.CategoryName.ToUpper()</h1>
    <p>@category.Description</p>
</div>

<!-- Thanh lọc theo khoảng giá và sắp xếp -->
<form method="get" action="@Url.Action("DanhMuc", "Home", new { id = category.CategoryID })" class="filter-bar">
    <input type="number" name="minPrice" value="@ViewBag.MinPrice" placeholder="Giá từ (VNĐ)..." />
    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="Giá đến (VNĐ)..." />
    <select name="sortOrder">
        <option value="">Mới nhất</option>
        <option value="price_asc" @(ViewBag.SortOrder == "price_asc" ? "selected" : "")>Giá tăng dần</option>
        <option value="price_desc" @(ViewBag.SortOrder == "price_desc" ? "selected" : "")>Giá giảm dần</option>
    </select>
    <button type="submit" class="btn-filter">Lọc sản phẩm</button>
</form>

<!-- Lưới danh sách sản phẩm của hãng -->
<div class="product-grid">
    @foreach (var item in Model)
    {
        decimal finalPrice = item.ProductPrice * (100 - item.DiscountPercent) / 100;
        string imgSrc = item.ProductImage != null && item.ProductImage.StartsWith("http") ? item.ProductImage : Url.Content("~/Content/image/" + item.ProductImage);

        <a href="@Url.Action("ChiTietSanPham", "Home", new { id = item.ProductID })" class="product-card">
            @if (item.DiscountPercent > 0)
            {
                <span class="badge-sale">-@item.DiscountPercent%</span>
            }
            <img src="@imgSrc" alt="@item.ProductName" />
            <div class="product-name">@item.ProductName</div>
            <div>
                <span class="sale-price">@finalPrice.ToString("N0")đ</span>
                @if (item.DiscountPercent > 0)
                {
                    <span class="old-price">@item.ProductPrice.ToString("N0")đ</span>
                }
            </div>
        </a>
    }
</div>

<!-- Phân trang -->
@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a href="@Url.Action("DanhMuc", "Home", new { id = category.CategoryID, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortOrder = ViewBag.SortOrder, page = i })"
               class="page-link @(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}