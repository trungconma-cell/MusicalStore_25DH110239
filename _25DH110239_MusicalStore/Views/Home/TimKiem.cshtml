@model List<_25DH110239_MusicalStore.Data.Product>
@{
    ViewBag.Title = "Tìm kiếm: " + ViewBag.Keyword;
}

<style>
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .product-card {
        border: 1px solid #eaeaea;
        border-radius: 6px;
        padding: 14px;
        position: relative;
        background: #fff;
    }

        .product-card img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 10px;
        }

    .sale-price {
        color: #d00;
        font-weight: 700;
    }
</style>

<h2>Kết quả tìm kiếm cho: "@ViewBag.Keyword" (@Model.Count sản phẩm)</h2>

<div class="product-grid">
    @foreach (var item in Model)
    {
        decimal finalPrice = item.ProductPrice * (100 - item.DiscountPercent) / 100;
        string imgSrc = item.ProductImage != null && item.ProductImage.StartsWith("http") ? item.ProductImage : Url.Content("~/Content/image/" + item.ProductImage);

        <a href="@Url.Action("ChiTietSanPham", "Home", new { id = item.ProductID })" class="product-card">
            <img src="@imgSrc" alt="@item.ProductName" />
            <div style="font-weight:600; margin-bottom:6px;">@item.ProductName</div>
            <div class="sale-price">@finalPrice.ToString("N0")đ</div>
        </a>
    }
</div>