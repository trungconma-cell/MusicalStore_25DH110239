@model List<_25DH110239_MusicalStore.Controllers.TopProductStat>
@{
    ViewBag.Title = "Thống kê doanh thu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-box {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
    }

        .stat-box h4 {
            font-size: 13px;
            color: #666;
            margin-bottom: 8px;
        }

        .stat-box .num {
            font-size: 22px;
            font-weight: 700;
            color: #111;
        }

    .card {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th, td {
        padding: 12px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    th {
        background: #f8f8f8;
        font-weight: 600;
    }
</style>

<div class="stats-grid">
    <div class="stat-box">
        <h4>TỔNG DOANH THU</h4>
        <div class="num" style="color:#d00;">@(((decimal)ViewBag.TongDoanhThu).ToString("N0"))đ</div>
    </div>
    <div class="stat-box">
        <h4>TỔNG ĐƠN HỢP LỆ</h4>
        <div class="num">@ViewBag.TongDonHang</div>
    </div>
    <div class="stat-box">
        <h4>ĐƠN HOÀN THÀNH</h4>
        <div class="num" style="color:#1a7f37;">@ViewBag.DonHoanThanh</div>
    </div>
    <div class="stat-box">
        <h4>ĐƠN ĐÃ HỦY</h4>
        <div class="num" style="color:#888;">@ViewBag.DonDaHuy</div>
    </div>
</div>

<div class="card">
    <h2 style="margin-bottom:15px;">Thống Kê Nhạc Cụ Bán Chạy</h2>
    <table>
        <thead>
            <tr>
                <th>STT</th>
                <th>Tên nhạc cụ</th>
                <th>Số lượng đã bán</th>
                <th>Doanh thu mang lại</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(stt++)</td>
                    <td><strong>@item.ProductName</strong></td>
                    <td>@item.TotalSold sản phẩm</td>
                    <td style="font-weight:700; color:#d00;">@item.Revenue.ToString("N0")đ</td>
                </tr>
            }
        </tbody>
    </table>
</div>